# このファイルを .env.local にコピーして値を入れます（.env.local は Git に入りません）。
# 値（鍵）はこのファイルには書かないでください。

# Rails API（ストア・ログイン・購入で使用）
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PAYJP_KEY=

# Slack 連携（どちらか一方を設定。どちらもなければ「お試し（送信しない）」）
# 1) Incoming Webhook の URL
SLACK_WEBHOOK_URL=
# 2) ボットのトークン（xoxb-）と投稿先チャンネル ID
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# POST /api/slack/kamo を呼ぶときの合言葉（設定すると、ヘッダー x-trigger-secret が必要になる）
SLACK_TRIGGER_SECRET=
# メッセージに付けるサイトの URL（例：https://example.com）
SITE_URL=

# Slack に投稿したイベントを道の駅のページに表示する（SLACK_BOT_TOKEN も必要。スコープ channels:history）
SLACK_EVENTS_CHANNEL_ID=
# Slack アプリの Signing Secret（投稿をすぐページに反映する /api/slack/events で使う）
SLACK_SIGNING_SECRET=

# 1日3回の自動更新（vercel.json の Cron Jobs）を呼ぶときの合言葉。Vercel が自動で付けて呼ぶ
CRON_SECRET=
