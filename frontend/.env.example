# このファイルを .env.local にコピーして値を入れます（.env.local は Git に入りません）。
# 値（鍵）はこのファイルには書かないでください。

# Rails API（ストアの出品一覧で使用）
NEXT_PUBLIC_API_URL=

# Slack 連携（どちらか一方を設定。どちらもなければ「お試し（送信しない）」）
# 1) Incoming Webhook の URL
SLACK_WEBHOOK_URL=
# 2) ボットのトークン（xoxb-）と投稿先チャンネル ID
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# POST /api/slack/kamo を呼ぶときの合言葉（設定すると、ヘッダー x-trigger-secret が必要になる）
SLACK_TRIGGER_SECRET=
# メッセージに付けるサイトの URL（例：https://example.com）
SITE_URL=

# Slack に投稿したイベントを道の駅のページに表示する（SLACK_BOT_TOKEN も必要。スコープ channels:history）
SLACK_EVENTS_CHANNEL_ID=
# Slack アプリの Signing Secret（投稿をすぐページに反映する /api/slack/events で使う）
SLACK_SIGNING_SECRET=

# 1日3回の自動更新（vercel.json の Cron Jobs）を呼ぶときの合言葉。Vercel が自動で付けて呼ぶ
CRON_SECRET=

# LINE 公式アカウントに送った写真を道の駅のページに載せる（/api/line/webhook）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 掲載してよい送り主のユーザー ID / グループ ID（カンマ区切り）
LINE_ALLOWED_IDS=
# 写真の保存先（Vercel の Storage で Blob をつなぐと自動で入る）
BLOB_READ_WRITE_TOKEN=

# 会員登録・サインイン（/api/auth/*）。セッションの署名に使う長いランダムな文字列（例：openssl rand -base64 32）
AUTH_SECRET=
# 会員を保存する「非公開」の Blob ストアのトークン（なければ BLOB_READ_WRITE_TOKEN を使う）
BLOB_PRIVATE_READ_WRITE_TOKEN=
# 管理者のメールアドレス（カンマ区切り）。この会員だけが /admin/photos で LINE の写真を承認できる
ADMIN_EMAILS=

# LINE 公式アカウントの友だち追加 URL（例：https://lin.ee/xxxx）。イベントの申し込みとシェアの欄に出す
NEXT_PUBLIC_LINE_FRIEND_URL=
